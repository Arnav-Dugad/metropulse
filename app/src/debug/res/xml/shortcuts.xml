<?xml version="1.0" encoding="utf-8"?>
<!-- Debug copy of main/res/xml/shortcuts.xml: shortcut intents need the literal (suffixed) package. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="io.github.arnavdugad.metropulse.action.SEARCH"
            android:targetPackage="io.github.arnavdugad.metropulse.debug"
            android:targetClass="io.github.arnavdugad.metropulse.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="on_board"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_train"
        android:shortcutShortLabel="@string/shortcut_onboard_short"
        android:shortcutLongLabel="@string/shortcut_onboard_long">
        <intent
            android:action="io.github.arnavdugad.metropulse.action.ON_BOARD"
            android:targetPackage="io.github.arnavdugad.metropulse.debug"
            android:targetClass="io.github.arnavdugad.metropulse.MainActivity" />
    </shortcut>
</shortcuts>
